<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup and device-to-device transfer rules: nothing leaves the device.

  `android:allowBackup="false"` in AndroidManifest.xml is the primary switch, but on Android 12+
  some manufacturers honour it for cloud backup only and still copy app data during a
  device-to-device transfer. These rules close that gap, so they must exclude everything in BOTH
  sections. A missing section means "transfer everything" for that mode.

  Why nothing: app-private storage is end-to-end-encrypted messenger state (the message database,
  ratchet state, MMKV stores) that is bound to this device's keys, and SecureStore values are
  sealed with Android Keystore keys that are never backed up. Restored on another device that data
  cannot be decrypted, and where it can be read it should not have left the device at all.

  Guarded by __tests__/androidBackupDisabled.test.ts. Not generated by Expo: a clean prebuild
  would delete this file (see PREBUILD.md). Note that XML forbids a double hyphen inside a comment,
  so do not paste command-line flags in here; aapt2 rejects the whole file.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="."/>
    <exclude domain="device_root" path="."/>
    <exclude domain="external" path="."/>
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="."/>
    <exclude domain="device_root" path="."/>
    <exclude domain="external" path="."/>
  </device-transfer>
</data-extraction-rules>
