# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Local-only snapshot of iOS customizations taken before expo prebuild.
# See PREBUILD.md.
.ios-snapshot/

# build
modules/*/android/build/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Headless DM harness (dev/harness) — LOCAL ONLY, NEVER COMMIT.
# .state/ holds persisted device keysets and logs/ holds captured ratchet
# state: both are REAL private key material from real accounts. The harness
# also talks to production, so these are not synthetic fixtures.
dev/harness/.state/
dev/harness/logs/

# typescript
*.tsbuildinfo

app-example

# Local agent tooling (not synced with upstream)
.claude/
.superpowers/

# --- must stay ignored even once .agents/ is published -----------------------

# Issue write-ups describing an attack that works against shipped code.
# See .agents/AGENTS.md -> "Security-sensitive issues".
.agents/issues/.secret/

# Logs and captures. Regenerated every run; carry account/machine names and,
# in transport traces, real key material.
.agents/**/*.log
.agents/**/*-log.txt
.agents/**/logs/
.agents/**/captures/

# Written by dev-start-mobile-wifi.ps1 each run.
.agents/reports/adb-wifi-endpoint.txt

# Machine-local script settings (see .agents/scripts/.env.local.example).
.agents/scripts/.env.local
